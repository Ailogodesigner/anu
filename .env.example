# ==============================================================================
# VPS HOSTING DISCORD BOT & MANAGEMENT DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vps_bot?schema=public"

# Discord Bot Credentials
# Obtain from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"
DISCORD_GUILD_ID="your_target_discord_server_id"

# Web Dashboard Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="generate_a_secure_random_64_character_hex_string_here"

# Discord OAuth2 Redirect URI (Must match Developer Portal OAuth2 Redirects)
# Example: http://localhost:3000/api/auth/callback/discord
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback/discord"

# Administrator Discord User IDs (Comma-separated IDs granted initial ADMIN role)
ADMIN_DISCORD_IDS="123456789012345678,987654321098765432"

# AI Provider API Keys (Optional - System gracefully falls back to built-in rule engine)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Security & Rate Limiting
MAX_TICKETS_PER_USER=3
TICKET_RATE_LIMIT_MINUTES=5
AUDIT_LOG_RETENTION_DAYS=90

# Environment Mode
NODE_ENV="development"
