{
  "name": "anu-vps-bot-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Premium VPS Hosting Discord Bot & Enterprise Management Dashboard",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev -p 3005",
    "build": "node node_modules/prisma/build/index.js db push --accept-data-loss && node node_modules/tsx/dist/cli.mjs prisma/seed.ts && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "bot": "node node_modules/tsx/dist/cli.mjs src/bot/index.ts",
    "bot:dev": "node node_modules/tsx/dist/cli.mjs watch src/bot/index.ts",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:push": "node node_modules/prisma/build/index.js db push",
    "prisma:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "discord.js": "^14.16.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
